{
  "version": 1,
  "name": "Skills Catalog Validation",
  "triggers": {
    "push": true,
    "tags": false,
    "manual": true
  },
  "stages": [
    {
      "id": "catalog",
      "label": "Validate and Package Skills",
      "image": "sha256:a7591fbcc603c9480a31100afc4f72916ab7d5ce67043a61854028f4a2ab8de5",
      "commands": [
        [
          "python",
          ".lley/run.py"
        ],
        [
          "python",
          "tools/catalog.py",
          "build"
        ]
      ],
      "timeout_seconds": 300,
      "memory_mb": 1024,
      "cpus": 1,
      "reports": [
        {
          "path": "reports/catalog.xml",
          "format": "junit"
        }
      ],
      "artifacts": [
        "dist/collection.zip",
        "dist/checksums.json"
      ]
    }
  ]
}
