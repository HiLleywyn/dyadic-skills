{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyadic.app/schemas/security-finding-v1.json",
  "title": "Dyadic security finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "target",
    "snapshot",
    "status",
    "confidence",
    "severity",
    "root_cause",
    "attack_path",
    "impact",
    "evidence",
    "counterevidence",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "title": { "type": "string", "minLength": 8, "maxLength": 200 },
    "target": { "type": "string", "minLength": 1 },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "assessed_at"],
      "properties": {
        "repository": { "type": "string" },
        "revision": { "type": "string", "minLength": 7 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "dirty_state": { "type": "string", "enum": ["clean", "dirty", "unknown", "not-applicable"] },
        "assessed_at": { "type": "string", "format": "date-time" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "needs-evidence", "validated-reportable", "validated-nonreportable", "disproven", "hardening-only", "fixed", "closed"]
    },
    "claim_state": {
      "type": "string",
      "enum": ["CONFIRMED", "CORROBORATED", "INFERRED", "UNRESOLVED", "DISPROVEN"]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational", "undetermined"] },
    "cvss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "vector"],
      "properties": {
        "version": { "type": "string", "enum": ["3.1", "4.0"] },
        "vector": { "type": "string", "minLength": 10 },
        "score": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-[1-9][0-9]*$" }, "uniqueItems": true },
    "root_cause": { "type": "string", "minLength": 20 },
    "attack_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "impact": { "type": "string", "minLength": 20 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "observation"],
        "properties": {
          "kind": { "type": "string", "enum": ["source", "test", "runtime", "history", "document", "response", "other"] },
          "locator": { "type": "string", "minLength": 1 },
          "observation": { "type": "string", "minLength": 4 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "counterevidence": { "type": "array", "items": { "type": "string" } },
    "affected_versions": { "type": "array", "items": { "type": "string" } },
    "fixed_versions": { "type": "array", "items": { "type": "string" } },
    "remediation": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "duplicate_of": { "type": "string" },
    "external_reference": { "type": "string", "format": "uri" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "validated-reportable" } }, "required": ["status"] },
      "then": { "properties": { "confidence": { "enum": ["high", "medium"] } } }
    }
  ]
}
